{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Workflow Details"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string",
          "description": "The start time"
        },
        "until": {
          "format": "date-time",
          "title": "Until",
          "type": "string",
          "description": "The end time"
        },
        "timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/TimezoneInfo"
            }
          ],
          "default": null,
          "title": "Timezone"
        },
        "time_format": {
          "default": "%d %b %Y %H:%M:%S",
          "title": "Time Format",
          "type": "string",
          "description": "The time format",
          "ecoscope:advanced": true
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "gee_client": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/GoogleEarthEngineConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to Google Earth Engine"
    },
    "er_client_name": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Connect to EarthRanger"
    },
    "create_land_layer": {
      "additionalProperties": false,
      "properties": {
        "tooltip_columns": {
          "default": null,
          "items": {
            "type": "string"
          },
          "title": "Tooltip Columns",
          "type": "array",
          "description": "Restrict the on-hover tooltip to these column names. None (default) shows all properties.",
          "ecoscope:advanced": true
        }
      },
      "type": "object",
      "required": [],
      "title": "Create amboseli land_use layer"
    },
    "create_bound_layer": {
      "additionalProperties": false,
      "properties": {
        "tooltip_columns": {
          "default": null,
          "items": {
            "type": "string"
          },
          "title": "Tooltip Columns",
          "type": "array",
          "description": "Restrict the on-hover tooltip to these column names. None (default) shows all properties.",
          "ecoscope:advanced": true
        }
      },
      "type": "object",
      "required": [],
      "title": "Create ambo ranch boundaries layer"
    },
    "create_fence_layer": {
      "additionalProperties": false,
      "properties": {
        "tooltip_columns": {
          "default": null,
          "items": {
            "type": "string"
          },
          "title": "Tooltip Columns",
          "type": "array",
          "description": "Restrict the on-hover tooltip to these column names. None (default) shows all properties.",
          "ecoscope:advanced": true
        }
      },
      "type": "object",
      "required": [],
      "title": "Create ambo electric fence layer"
    },
    "get_events_data": {
      "additionalProperties": false,
      "properties": {
        "event_states": {
          "default": null,
          "items": {
            "type": "string",
            "oneOf": [
              {
                "const": "new",
                "title": "New"
              },
              {
                "const": "active",
                "title": "Active"
              },
              {
                "const": "resolved",
                "title": "Resolved"
              },
              {
                "const": "review",
                "title": "Review"
              }
            ]
          },
          "title": "Event State",
          "type": "array",
          "description": "Choose to analyze events with a certain state. If left empty, events of all states will be analyzed",
          "uniqueItems": true,
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": "Retrieve rainfall events only"
    },
    "extract_event_date": {
      "additionalProperties": false,
      "properties": {
        "fan_out": {
          "default": true,
          "title": "Fan Out",
          "type": "boolean",
          "description": "Only used when output_type is 'series'. If true (default), expand the extracted collection into indexed columns prefixed by output_column_name. If false, store it as a list in a single output_column_name column."
        }
      },
      "required": [],
      "type": "object",
      "title": "Extract date from events data"
    },
    "rename_weather_columns": {
      "additionalProperties": false,
      "properties": {
        "duplicate_strategy": {
          "default": "suffix",
          "enum": [
            "suffix",
            "skip",
            "overwrite",
            "error"
          ],
          "title": "Duplicate Strategy",
          "type": "string",
          "description": "Strategy for handling a rename whose new name is already taken. 'suffix': append _1, _2, etc. to the new name; 'skip': skip the rename, leaving the column under its original name; 'overwrite': replace the existing column; 'error': raise ValueError.",
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": "Rename weather event columns"
    },
    "rename_rainfall_table_columns": {
      "additionalProperties": false,
      "properties": {
        "duplicate_strategy": {
          "default": "suffix",
          "enum": [
            "suffix",
            "skip",
            "overwrite",
            "error"
          ],
          "title": "Duplicate Strategy",
          "type": "string",
          "description": "Strategy for handling a rename whose new name is already taken. 'suffix': append _1, _2, etc. to the new name; 'skip': skip the rename, leaving the column under its original name; 'overwrite': replace the existing column; 'error': raise ValueError.",
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": "Rename rainfall station table columns"
    },
    "ndvi_method": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "",
          "type": "string"
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": "NDVI Method"
    },
    "calculate_ndvi": {
      "additionalProperties": false,
      "properties": {
        "grouping_unit": {
          "default": "month",
          "enum": [
            "month",
            "week",
            "day_of_year",
            "modis_16_day"
          ],
          "title": "Grouping Unit",
          "type": "string",
          "description": "Temporal unit for grouping historical data when calculating statistics. 'month': Compare against same calendar month (1-12). 'week': Compare against same ISO week number (1-53). 'day_of_year': Compare against same day of year (1-366). 'modis_16_day': Compare against same MODIS 16-day composite period (0-22)."
        }
      },
      "required": [],
      "type": "object",
      "title": "NDVI Trend"
    }
  },
  "$defs": {
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
